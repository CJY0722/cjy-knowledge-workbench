<view class="shell">
  <view class="sidebar">
    <view class="brand"><view class="brand-mark">知</view><view><text class="block">CJY 知识工作台</text><text class="muted">个人知识与博客</text></view></view>
    <view class="nav"><button wx:for="{{tabs}}" wx:key="id" class="nav-item {{activeTab === item.id ? 'active' : ''}}" data-tab="{{item.id}}" bindtap="selectTab">{{item.label}}</button></view>
    <view class="device-status"><view class="status-dot"></view><view><text class="block">本机数据隔离</text><text class="muted">不上传维护者服务器</text></view></view>
  </view>

  <view class="content">
    <view class="mobile-brand"><text>CJY 知识工作台</text><button bindtap="importMarkdown">导入</button></view>
    <scroll-view class="mobile-nav" scroll-x enhanced show-scrollbar="false"><button wx:for="{{tabs}}" wx:key="id" class="nav-chip {{activeTab === item.id ? 'active' : ''}}" data-tab="{{item.id}}" bindtap="selectTab">{{item.label}}</button></scroll-view>
    <view wx:if="{{notice}}" class="notice">{{notice}}</view>

    <view wx:if="{{activeTab === 'overview'}}" class="page">
      <view class="page-head"><view><text class="h1">知识概览</text><text class="lead">导入自己的 Obsidian Markdown，在手机和电脑微信中整理。</text></view><button class="primary" bindtap="importMarkdown">导入 Markdown</button></view>
      <view class="stats four"><view class="card"><text class="stat">{{notes.length}}</text><text class="block">本地笔记</text></view><view class="card"><text class="stat">{{tasks.length}}</text><text class="block">任务条目</text></view><view class="card"><text class="stat">{{stats.linkIntegrity}}%</text><text class="block">链接完整度</text></view><view class="card"><text class="stat">{{stats.metadataCoverage}}%</text><text class="block">元数据覆盖</text></view></view>
      <view class="panel empty" wx:if="{{!notes.length}}"><text class="h2">从自己的知识库开始</text><text class="paragraph">从微信会话导入 Markdown / TXT；数据只保存在当前设备。</text><button class="primary" bindtap="importMarkdown">选择微信文件</button></view>
      <view class="panel" wx:else><text class="h2">最近笔记</text><view wx:for="{{notes}}" wx:key="id" wx:if="{{index < 6}}" class="note-row" data-id="{{item.id}}" bindtap="openNote"><view><text class="row-title">{{item.title}}</text><text class="muted">{{item.characters}} 字</text></view><text class="link">编辑</text></view></view>
    </view>

    <view wx:if="{{activeTab === 'today'}}" class="page">
      <view class="page-head"><view><text class="h1">今日任务</text><text class="lead">识别并更新 Markdown 中的任务复选框。</text></view></view>
      <view class="panel empty" wx:if="{{!tasks.length}}"><text class="h2">暂无任务</text><text class="paragraph">导入包含 - [ ] 的 Markdown 笔记后会显示在这里。</text></view>
      <view class="panel" wx:else><button wx:for="{{tasks}}" wx:key="line" class="task-row {{item.done ? 'done' : ''}}" data-note="{{item.noteId}}" data-line="{{item.line}}" bindtap="toggleTask"><text class="task-check">{{item.done ? '✓' : '○'}}</text><view><text class="row-title">{{item.text}}</text><text class="muted">{{item.noteTitle}}{{item.due ? ' · ' + item.due : ''}}</text></view></button></view>
    </view>

    <view wx:if="{{activeTab === 'library'}}" class="page">
      <view class="page-head"><view><text class="h1">知识库</text><text class="lead">检索已导入、剪藏和新建的 Markdown。</text></view><button class="primary" bindtap="importMarkdown">导入</button></view>
      <input class="search" placeholder="搜索标题、文件名或正文" value="{{query}}" bindinput="setQuery" />
      <view class="panel empty" wx:if="{{!filteredNotes.length}}"><text class="h2">没有匹配内容</text><text class="paragraph">换一个关键词，或先导入 Markdown 文件。</text></view>
      <view class="note-grid" wx:else><view wx:for="{{filteredNotes}}" wx:key="id" class="note-card" data-id="{{item.id}}" bindtap="openNote"><text class="row-title">{{item.title}}</text><text class="excerpt">{{item.content}}</text><text class="muted">{{item.characters}} 字 · 点击编辑</text></view></view>
    </view>

    <view wx:if="{{activeTab === 'clippings'}}" class="page">
      <view class="page-head"><view><text class="h1">剪藏</text><text class="lead">快速把灵感和资料放入本机收件箱。</text></view></view>
      <view class="panel editor compact"><text class="field-label">标题</text><input value="{{clippingTitle}}" placeholder="资料标题" bindinput="setClippingTitle" /><text class="field-label">内容</text><textarea value="{{clippingBody}}" placeholder="粘贴摘要、想法或链接" bindinput="setClippingBody" maxlength="-1"></textarea><button class="primary" bindtap="saveClipping">存入收件箱</button></view>
      <view class="note-grid section-gap"><view wx:for="{{clippings}}" wx:key="id" class="note-card" data-id="{{item.id}}" bindtap="openNote"><text class="row-title">{{item.title}}</text><text class="excerpt">{{item.content}}</text><text class="muted">剪藏 · {{item.characters}} 字</text></view></view>
    </view>

    <view wx:if="{{activeTab === 'graph'}}" class="page">
      <view class="page-head"><view><text class="h1">关系图谱</text><text class="lead">根据 Obsidian WikiLink 检查显式关系。</text></view></view>
      <view class="stats"><view class="card"><text class="stat">{{notes.length}}</text><text class="block">节点</text></view><view class="card"><text class="stat">{{stats.edges.length}}</text><text class="block">关系</text></view><view class="card"><text class="stat">{{stats.orphans.length}}</text><text class="block">孤立笔记</text></view></view>
      <view class="two-columns"><view class="panel"><text class="h2">已解析关系</text><view wx:for="{{stats.edges}}" wx:key="target" class="relation-row"><text>{{item.sourceTitle}}</text><text class="link">→ {{item.targetTitle}}</text></view><text wx:if="{{!stats.edges.length}}" class="muted">尚未发现 WikiLink 关系</text></view><view class="panel"><text class="h2">失效链接</text><view wx:for="{{stats.brokenLinks}}" wx:key="target" class="relation-row"><text>{{item.source}}</text><text class="warning">→ {{item.target}}</text></view><text wx:if="{{!stats.brokenLinks.length}}" class="muted">没有失效链接</text></view></view>
    </view>

    <view wx:if="{{activeTab === 'review'}}" class="page">
      <view class="page-head"><view><text class="h1">知识回顾</text><text class="lead">优先回顾长期未更新和孤立笔记。</text></view><button bindtap="nextReview" disabled="{{!reviewNote}}">换一篇</button></view>
      <view class="panel empty" wx:if="{{!reviewNote}}"><text class="h2">暂无待回顾笔记</text><text class="paragraph">当前导入内容没有长期未更新或孤立笔记。</text></view>
      <view class="panel review-focus" wx:else data-id="{{reviewNote.id}}" bindtap="openNote"><text class="h2">{{reviewNote.title}}</text><text class="excerpt long">{{reviewNote.content}}</text><text class="muted">{{reviewNote.fileName}} · 点击打开编辑</text></view>
    </view>

    <view wx:if="{{activeTab === 'blog'}}" class="page">
      <view class="page-head"><view><text class="h1">博客写作</text><text class="lead">写作、检查、生成五平台物料，再人工发布。</text></view><button bindtap="newDraft">新建原创</button></view>
      <view class="editor panel"><text class="field-label">文章标题</text><input value="{{editorTitle}}" placeholder="输入文章标题" bindinput="setEditorTitle" /><text class="field-label">Markdown 正文</text><textarea value="{{editorBody}}" placeholder="从这里开始写作，或在知识库中打开已有文章。" bindinput="setEditorBody" maxlength="-1"></textarea><view class="actions wrap"><button class="primary" bindtap="saveDraft">保存草稿</button><button bindtap="runAudit">文章检查</button><button bindtap="generateMaterials">生成五平台物料</button><button bindtap="exportDraft">导出到 Obsidian</button></view></view>
      <view wx:if="{{audit}}" class="panel section-gap audit {{audit.ready ? 'ready' : 'blocked'}}"><text class="h2">{{audit.ready ? '没有发布阻塞项' : audit.blockers.length + ' 个发布阻塞项'}}</text><text wx:for="{{audit.blockers}}" wx:key="*this" class="warning">阻塞 · {{item}}</text><text wx:for="{{audit.warnings}}" wx:key="*this" class="muted">提醒 · {{item}}</text></view>
      <view wx:if="{{materials.length}}" class="panel section-gap"><text class="h2">多平台物料</text><scroll-view scroll-x class="material-tabs"><button wx:for="{{materials}}" wx:key="platform" class="nav-chip {{activeMaterial.platform === item.platform ? 'active' : ''}}" data-platform="{{item.platform}}" bindtap="selectMaterial">{{item.name}}</button></scroll-view><view wx:if="{{activeMaterial}}" class="material"><text class="row-title">{{activeMaterial.format}}</text><text class="muted">{{activeMaterial.content.length}} 字{{activeMaterial.cardPages.length ? ' · ' + activeMaterial.cardPages.length + ' 张图卡内容' : ''}}</text><textarea value="{{activeMaterial.content}}" disabled maxlength="-1"></textarea><view class="actions wrap"><button bindtap="copyMaterialTitle">复制标题</button><button class="primary" bindtap="copyMaterial">复制发布正文</button><button bindtap="completePublish" disabled="{{!publishStarted}}">已发布并清空</button></view><view wx:if="{{activeMaterial.cardPages.length}}" class="card-pages"><view wx:for="{{activeMaterial.cardPages}}" wx:key="*this" class="text-card"><text>{{item}}</text><text class="muted">{{index + 1}} / {{activeMaterial.cardPages.length}}</text></view></view></view></view>
    </view>

    <view wx:if="{{activeTab === 'settings'}}" class="page">
      <view class="page-head"><view><text class="h1">设置与隐私</text><text class="lead">正式小程序使用独立本机数据，不共享维护者知识库。</text></view></view>
      <view class="panel settings-list"><view><text class="row-title">正式小程序项目</text><text>已绑定正式 AppID</text></view><view><text class="row-title">数据存储</text><text>当前微信设备本地存储</text></view><view><text class="row-title">Obsidian</text><text>通过 Markdown 导入与导出</text></view><view><text class="row-title">DeepSeek</text><text>等待微信云开发环境，不保存共享密钥</text></view><view><text class="row-title">跨设备同步</text><text>等待微信云开发环境</text></view></view>
      <view class="actions section-gap"><button class="primary" bindtap="importMarkdown">导入 Markdown</button><button bindtap="exportDraft" disabled="{{!editorBody}}">导出当前文章</button></view>
    </view>
  </view>
</view>
