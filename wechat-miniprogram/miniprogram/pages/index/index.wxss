.shell { min-height: 100vh; display: flex; }
.sidebar { width: 250rpx; min-height: 100vh; box-sizing: border-box; padding: 38rpx 24rpx; background: #edf1ea; border-right: 1rpx solid #dce3d8; display: flex; flex-direction: column; }
.brand { display: flex; align-items: center; gap: 18rpx; font-weight: 700; }
.brand-mark { width: 64rpx; height: 64rpx; border-radius: 18rpx; display: grid; place-items: center; color: #fff; background: #35634a; }
.block { display: block; }
.muted { display: block; margin-top: 6rpx; color: #718075; font-size: 20rpx; font-weight: 400; }
.nav { display: grid; gap: 10rpx; margin-top: 56rpx; }
.nav-item { margin: 0; padding: 20rpx 24rpx; line-height: 1; text-align: left; font-size: 26rpx; color: #526056; background: transparent; border-radius: 16rpx; }
.nav-item.active { color: #234c36; background: #dbe8de; font-weight: 700; }
.device-status { margin-top: auto; padding-top: 28rpx; border-top: 1rpx solid #d2dad0; display: flex; gap: 14rpx; align-items: center; }
.status-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #3d7a58; }
.content { flex: 1; min-width: 0; box-sizing: border-box; padding: 48rpx; }
.mobile-brand, .mobile-nav { display: none; }
.page { max-width: 1180rpx; margin: 0 auto; }
.page-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; margin-bottom: 34rpx; }
.h1, .h2, .lead, .paragraph, .row-title, .excerpt { display: block; }
.h1 { font-size: 42rpx; line-height: 1.25; font-weight: 700; }
.h2 { margin-bottom: 12rpx; font-size: 30rpx; font-weight: 700; }
.lead, .paragraph, .excerpt { color: #6b776f; }
.lead { margin-top: 12rpx; }
button { margin: 0; padding: 18rpx 28rpx; line-height: 1; font-size: 24rpx; color: #35423a; background: #fff; border: 1rpx solid #d4dcd2; border-radius: 14rpx; }
button.primary { color: #fff; background: #35634a; border-color: #35634a; }
.notice { max-width: 1180rpx; margin: 0 auto 28rpx; padding: 20rpx 24rpx; color: #31533f; background: #e3eee5; border-radius: 14rpx; }
.stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22rpx; margin-bottom: 26rpx; }
.card, .panel, .note-card { background: #fff; border: 1rpx solid #dfe5dc; border-radius: 22rpx; }
.card { padding: 32rpx; }
.card strong, .card span { display: block; }
.card strong { font-size: 52rpx; color: #315940; }
.card span { margin-top: 8rpx; color: #718075; }
.panel { padding: 30rpx; }
.empty { min-height: 250rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.empty .paragraph { max-width: 620rpx; margin-bottom: 22rpx; }
.note-row, .task-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 22rpx 0; border-bottom: 1rpx solid #edf0eb; }
.note-row:last-child, .task-row:last-child { border-bottom: 0; }
.row-title { font-weight: 700; }
.link { color: #35634a; }
.task-row { justify-content: flex-start; }
.task-check { width: 42rpx; height: 42rpx; flex: none; display: grid; place-items: center; color: #35634a; border: 1rpx solid #a9b8ad; border-radius: 50%; }
.task-row.done { opacity: .58; }
.task-row.done .row-title { text-decoration: line-through; }
.search, .editor input { box-sizing: border-box; width: 100%; padding: 22rpx 24rpx; background: #fff; border: 1rpx solid #d6ded4; border-radius: 16rpx; }
.search { margin-bottom: 24rpx; }
.note-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22rpx; }
.note-card { min-width: 0; padding: 28rpx; }
.excerpt { height: 84rpx; margin: 16rpx 0; overflow: hidden; line-height: 1.6; word-break: break-all; }
.field-label { display: block; margin: 6rpx 0 12rpx; color: #425047; font-weight: 700; }
.editor textarea { box-sizing: border-box; width: 100%; height: 700rpx; margin: 12rpx 0 24rpx; padding: 24rpx; line-height: 1.7; background: #f9faf7; border: 1rpx solid #d6ded4; border-radius: 16rpx; }
.actions { display: flex; gap: 16rpx; }
.settings-list { display: grid; gap: 0; }
.settings-list > view { display: flex; justify-content: space-between; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid #edf0eb; }
.settings-list > view:last-child { border-bottom: 0; }
.settings-list span { color: #738078; text-align: right; }

@media (max-width: 750px) {
  .shell { display: block; }
  .sidebar { display: none; }
  .content { padding: 24rpx; }
  .mobile-brand { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; font-size: 30rpx; font-weight: 700; }
  .mobile-brand button { padding: 14rpx 24rpx; }
  .mobile-nav { display: block; width: 100%; white-space: nowrap; margin-bottom: 26rpx; }
  .nav-chip { display: inline-block; margin-right: 12rpx; padding: 16rpx 24rpx; background: #fff; }
  .nav-chip.active { color: #fff; background: #35634a; border-color: #35634a; }
  .page-head { align-items: flex-end; }
  .h1 { font-size: 36rpx; }
  .stats { grid-template-columns: 1fr; gap: 14rpx; }
  .card { padding: 24rpx; }
  .note-grid { grid-template-columns: 1fr; }
  .editor textarea { height: 760rpx; }
  .settings-list > view { display: block; }
  .settings-list span { display: block; margin-top: 8rpx; text-align: left; }
}
